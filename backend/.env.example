# Copie para .env e ajuste. NÃO comite o .env real.
#   cp .env.example .env

# --- Postgres ---
POSTGRES_DB=goferias
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-do-postgres

# Senha do role de conexão do PostgREST (usuário `authenticator`)
AUTHENTICATOR_PASSWORD=troque-esta-senha-do-authenticator

# Segredo do JWT — MESMO valor usado pelo banco e pelo PostgREST.
# Mínimo 32 caracteres. Gere um forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-no-minimo-32-chars
