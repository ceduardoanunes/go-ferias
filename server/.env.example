# Copie para .env e ajuste.  cp .env.example .env

# --- Banco (o docker-compose usa estas p/ subir o Postgres) ---
POSTGRES_DB=goferias
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Conexão que a API usa (host "db" = serviço do compose)
DATABASE_URL=postgresql://postgres:troque-esta-senha@db:5432/goferias?schema=public

# --- Segurança ---
# Mínimo 32 chars. Gere:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA=12h
PORT=3000

# --- E-mail (SMTP). Deixe SMTP_HOST vazio para desativar o envio. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Go Férias! <no-reply@suaempresa.com.br>
